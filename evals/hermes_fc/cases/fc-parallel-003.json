      "function": {
        "name": "transform_json",
        "description": "Apply a small set of named transforms to a JSON value loaded from disk. Returns the transformed value as a JSON string. `operation` is one of: 'rename_field' (rename a top-level field — args: {\"from\": \"old_name\", \"to\": \"new_name\"}), 'drop_field' (remove a top-level field — args: {\"field\": \"field_name\"}), 'project' (keep only a whitelisted set of top-level fields — args: {\"fields\": [\"field_a\", \"field_b\"]}).",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "operation": {
              "type": "string",
              "enum": [
                "rename_field",
                "drop_field",
                "project"
              ]
            },
            "args": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "path",
            "operation",
            "args"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
