          },
          "required": [
            "title",
            "attendees",
            "date",
            "time",
            "timezone",
            "duration_minutes"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "list_calendar",
